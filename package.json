{
  "name": "anylint-vscode",
  "displayName": "AnyLint",
  "description": "Inline-підказки з anylint (кросплатформного статичного аналізатора, 16 мов) прямо в редакторі, з quick fix для правил, що це підтримують.",
  "version": "0.1.0",
  "publisher": "Faneraiy14",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Faneraiy14/anylint-vscode.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Linters"
  ],
  "main": "./extension.js",
  "scripts": {
    "test": "node --test test/*.mjs"
  },
  "devDependencies": {
    "vscode": "file:test/vscode-mock"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "AnyLint",
      "properties": {
        "anylint.phpPath": {
          "type": "string",
          "default": "php",
          "description": "Команда для запуску PHP (сам anylint написаний на PHP, незалежно від того, яку мову він аналізує)."
        },
        "anylint.binPath": {
          "type": "string",
          "default": "",
          "description": "Абсолютний шлях до bin/anylint (клон репозиторію Faneraiy14/anylint). Порожньо = розширення спробує знайти сусідню теку \"anylint\" автоматично."
        },
        "anylint.runOn": {
          "type": "string",
          "enum": ["save", "type"],
          "default": "save",
          "description": "Коли перезапускати аналіз: після збереження файлу, чи (з невеликою затримкою) під час набору."
        }
      }
    },
    "commands": [
      {
        "command": "anylint.runOnCurrentFile",
        "title": "AnyLint: перевірити поточний файл"
      },
      {
        "command": "anylint.refreshAll",
        "title": "AnyLint: перевірити всі відкриті файли",
        "icon": "$(refresh)"
      },
      {
        "command": "anylint.scanWorkspace",
        "title": "AnyLint: перевірити весь workspace",
        "icon": "$(search)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "anylint",
          "title": "AnyLint",
          "icon": "media/activitybar-icon.svg"
        }
      ]
    },
    "views": {
      "anylint": [
        {
          "id": "anylintFindings",
          "name": "Знахідки",
          "icon": "media/activitybar-icon.svg",
          "contextualTitle": "AnyLint"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "anylint.scanWorkspace",
          "when": "view == anylintFindings",
          "group": "navigation@1"
        },
        {
          "command": "anylint.refreshAll",
          "when": "view == anylintFindings",
          "group": "navigation@2"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "anylintFindings",
        "contents": "Немає знахідок у відкритих файлах.\n[Перевірити весь workspace](command:anylint.scanWorkspace)\n[Перевірити лише відкриті файли](command:anylint.refreshAll)"
      }
    ]
  }
}
